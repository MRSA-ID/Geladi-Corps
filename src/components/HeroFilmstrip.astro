---
import { Image } from "astro:assets";

import BrandsArkaloka from "@assets/images/brands/brands_arkaloka.png"
import BrandsDusantaraid from "@assets/images/brands/brands_dusantaraid_package.jpg"
import BrandsSakaParfumery from "@assets/images/brands/brands_saka_parfumery.png"
import BrandsSakaAmbient from "@assets/images/brands/brands_saka_ambient.png"
import BrandsSafeeyaUmroh from "@assets/images/brands/brands_safeeyaumroh.jpg"
import BrandsMeetcationAsia from "@assets/images/brands/brands_meetcation_asia.png"
import BrandsMeetcationEurope from "@assets/images/brands/brands_meetcation_europe.png"
import BrandsMeetcationNewZealand from "@assets/images/brands/brands_meetcation_newzealand.png"
import BrandsMeetcationUsa from "@assets/images/brands/brands_meetcation_usa.png"

import ounce from "@assets/images/logo_brands/8ounce_logo_color.png"
import meetcation from "@assets/images/logo_brands/meetcation_logo_color.png"
import nirmala from "@assets/images/logo_brands/nirmala_logo_only_color.png"
import whiff from "@assets/images/logo_brands/whiff_logo_color.png"
import saka from "@assets/images/logo_brands/saka_logo_color.png"
import arkaloka from "@assets/images/logo_brands/arkaloka_logo_color.png"
import dusantara from "@assets/images/logo_brands/dusantara_logo.png"
import safeeya from "@assets/images/logo_brands/safeeyaumroh_logo_color.png"
import noomadbook from "@assets/images/logo_brands/nomadbookid_logo_color.png"

interface SlideItem {
	src: ImageMetadata;
	alt: string;
	heightClass?: string;
	offsetClass?: string;
	objectPositionClass?: string;
}

interface LogoItem {
	name: string;
	src: ImageMetadata;
	alt: string;
}

interface Props {
	kicker?: string;
	title?: string;
	description?: string;
	primaryCta?: {
		text: string;
		href: string;
	};
	secondaryCta?: {
		text: string;
		href: string;
	};
	slides?: SlideItem[];
	logos?: LogoItem[];
}

const defaultSlides: SlideItem[] = [
	{
		src: BrandsArkaloka,
		alt: "Brand Arlaloka ",
		heightClass: "h-88 sm:h-96 md:h-[430px]",
		offsetClass: "translate-y-0 hover:-translate-y-8",
		objectPositionClass:'object-top'
	},
	{
		src: BrandsDusantaraid,
		alt: "Brand Dusantara package",
		heightClass: "h-96 sm:h-[440px] md:h-[480px]",
		offsetClass: "translate-y-0 hover:-translate-y-8",
	},
	{
		src: BrandsSakaParfumery,
		alt: "Brand Saka Parfumery",
		heightClass: "h-80 sm:h-88 md:h-[390px]",
		offsetClass: "translate-y-6 hover:-translate-y-8",
		objectPositionClass:"object-left"
	},
	{
		src: BrandsSakaAmbient,
		alt: "Brand Saka Ambient",
		heightClass: "h-88 sm:h-96 md:h-[430px]",
		offsetClass: "translate-y-2 hover:-translate-y-8",
		objectPositionClass:"object-left"
	},
	{
		src: BrandsSafeeyaUmroh,
		alt: "Brand Safeeya Umroh",
		heightClass: "h-72 sm:h-80 md:h-96",
		offsetClass: "translate-y-10 hover:-translate-y-6",
	},
	{
		src: BrandsMeetcationAsia,
		alt: "Brand Meetcation Asia",
		heightClass: "h-88 sm:h-[420px] md:h-[460px]",
		offsetClass: "translate-y-4 hover:-translate-y-8",
		objectPositionClass:'object-top'
	},
	{
		src: BrandsMeetcationEurope,
		alt: "Brand Meetcation Europe",
		heightClass: "h-80 sm:h-92 md:h-[400px]",
		offsetClass: "translate-y-6 hover:-translate-y-8",
		objectPositionClass:'object-top'
	},
	{
		src: BrandsMeetcationNewZealand,
		alt: "Brand Meetcation New Zealand",
		heightClass: "h-96 sm:h-[450px] md:h-[490px]",
		offsetClass: "translate-y-0 hover:-translate-y-8",
		objectPositionClass:"object-left"
	},
	{
		src: BrandsMeetcationUsa,
		alt: "Brand Meetcation Usa",
		heightClass: "h-72 sm:h-84 md:h-96",
		offsetClass: "translate-y-8 hover:-translate-y-6",
	} 
];

const defaultLogos: LogoItem[] = [
	{ name: "8ounce", src: ounce, alt:"nomadbookid logo color" },
	{ name: "meetcation", src: meetcation, alt:"meetcation logo color" },
	{ name: "nirmala project", src: nirmala, alt:"nirmala logo color" },
	{ name: "whiff", src: whiff, alt:"whiff logo color" },
	{ name: "saka", src: saka, alt:"saka logo color" },
	{ name: "arkaloka", src: arkaloka, alt:"arkaloka logo color" },
	{ name: "dusantara", src: dusantara, alt:"dusantara logo color" },
	{ name: "safeeya umroh", src: safeeya, alt:"safeeya umroh logo color" },
	{ name: "noomadbook", src: noomadbook, alt:"noomadbook logo color" },

];

const {
	title = "Blocks Built\nWith Shadcn & Tailwind.",
	slides = defaultSlides,
	logos = defaultLogos,
} = Astro.props;
---
<!--  -->
<style>
	/* Zero-FOUC hidden state before hero reveals */
	#hero-section:not(.hero-revealed) #hero-heading,
	#hero-section:not(.hero-revealed) #hero-description,
	#hero-section:not(.hero-revealed) #hero-marquee,
	#hero-section:not(.hero-revealed) #hero-filmstrip-wrapper {
		opacity: 0;
	}

	/* Clean static document state once revealed */
	#hero-section.hero-revealed #hero-heading,
	#hero-section.hero-revealed #hero-description,
	#hero-section.hero-revealed #hero-marquee,
	#hero-section.hero-revealed #hero-filmstrip-wrapper {
		opacity: 1;
		transform: none !important;
		filter: none !important;
	}
</style>

<section id="hero-section" class="relative pt-20 pb-0 sm:pt-24 md:pt-48 font-testsohne overflow-hidden bg-primary_limestone text-neutral-900 antialiased">
	<div class="pointer-events-none absolute inset-x-0 top-0 h-96 bg-radial from-neutral-200/40 via-transparent to-transparent opacity-70"></div>

	<div class="relative mx-auto max-w-6xl px-4 text-center sm:px-6 lg:px-8">
		<h1
			id="hero-heading"
			class="mx-auto font-canela max-w-5xl text-5xl md:text-7xl font-bold tracking-tight text-secondary_deep_moss leading-[1.12] whitespace-pre-line backface-hidden transform-[translateZ(0)]"
		>
			Synergy Driving Ecosystems, Carving Sustainable Value
		</h1>

		<p
			id="hero-description"
			class="mx-auto mt-6 max-w-3xl text-sm sm:text-lg font-normal text-secondary_deep_moss backface-hidden transform-[translateZ(0)]"
		>
			9 commercial brands and 3 digital media platforms spanning Fragrance & Personal Care, Travel & Hospitality, Experiential Events & Industrial Creative, and Human Capital Consulting.
		</p>

		<div
			id="hero-marquee"
			class="marquee-container relative mt-4 sm:mt-8 overflow-hidden py-4 select-none"
		>
			<div class="edge-fade-mask relative flex w-full overflow-hidden gap-12 sm:gap-16">
				<div class="animate-marquee flex shrink-0 min-w-full items-center justify-around gap-12 sm:gap-16">
					{logos.map((logo) => (
						<div class="flex items-center justify-center shrink-0">
							<Image
								src={logo.src}
								alt={logo.alt}
								height={150}
								densities={[1, 2]}
								format="webp"
								quality={95}
								loading="eager"
								decoding="async"
								class="w-auto max-w-[150px] object-contain transition-transform duration-300 hover:scale-105"
							/>
						</div>
					))}
				</div>

				<div class="animate-marquee flex shrink-0 min-w-full items-center justify-around gap-12 sm:gap-16" aria-hidden="true">
					{logos.map((logo) => (
						<div class="flex items-center justify-center shrink-0">
							<Image
								src={logo.src}
								alt={logo.alt}
								height={150}
								densities={[1, 2]}
								format="webp"
								quality={95}
								loading="eager"
								decoding="async"
								class="w-auto max-w-[150px] object-contain transition-transform duration-300 hover:scale-105"
							/>
						</div>
					))}
				</div>
			</div>
		</div>
	</div>

	<div
		id="hero-filmstrip-wrapper"
		class="relative mt-8 sm:mt-12 w-full pb-0"
	>
		<div class="swiper-container swiper-hero-filmstrip overflow-hidden">
			<div class="swiper-wrapper flex items-end">
				{slides.map((slide) => (
					<div class="swiper-slide !h-auto flex items-end justify-center translate-y-18">
						<div
							class:list={[
								"group relative w-full overflow-hidden rounded-t-[1.75rem] sm:rounded-t-3xl border border-neutral-300/80 bg-neutral-200/50 shadow-sm transition-transform duration-500 ease-out cursor-grab active:cursor-grabbing",
								slide.heightClass || "h-80 sm:h-96",
								slide.offsetClass || "hover:-translate-y-18",
							]}
						>
							<Image
								src={slide.src}
								alt={slide.alt}
								width={1200}
								height={1000}
								class:list={["h-full w-full object-cover select-none pointer-events-none transition-transform duration-700 group-hover:scale-105",
								slide.objectPositionClass
								]}
								loading="eager"
								decoding="async"
							/>
							<div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
						</div>
					</div>
				))}
			</div>
		</div>
	</div>
</section>

<script>
	import gsap from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	import Swiper from "swiper";
	import { Autoplay } from "swiper/modules";

	gsap.registerPlugin(ScrollTrigger);

	function initHeroSwiper() {
		const swiperEl = document.querySelector(".swiper-hero-filmstrip");
		if (!swiperEl) return;

		if ((swiperEl as any).swiper) {
			(swiperEl as any).swiper.destroy(true, true);
		}

		new Swiper(".swiper-hero-filmstrip", {
			modules: [Autoplay],
			loop: true,
			speed: 1200,
			spaceBetween: 16,
			slidesPerView: 1.5,
			centeredSlides: false,
			autoplay: {
				delay: 2400,
				disableOnInteraction: false,
				pauseOnMouseEnter: false,
			},
			breakpoints: {
				480: {
					slidesPerView: 2.2,
					spaceBetween: 16,
				},
				640: {
					slidesPerView: 3,
					spaceBetween: 18,
				},
				840: {
					slidesPerView: 4,
					spaceBetween: 20,
				},
				1024: {
					slidesPerView: 5,
					spaceBetween: 20,
				},
			},
		});
	}

	function initHeroEntrance() {
		const section = document.getElementById("hero-section");
		const heading = document.getElementById("hero-heading");
		const desc = document.getElementById("hero-description");
		const marquee = document.getElementById("hero-marquee");
		const filmstrip = document.getElementById("hero-filmstrip-wrapper");

		if (!section || !heading || !desc) {
			window.dispatchEvent(new CustomEvent("galedi:hero-done"));
			return;
		}

		// Abort any existing tweens on these elements
		gsap.killTweensOf([heading, desc, marquee, filmstrip]);

		const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		if (prefersReducedMotion) {
			section.classList.add("hero-revealed");
			gsap.set([heading, desc, marquee, filmstrip], { opacity: 1, y: 0, filter: "none" });
			window.dispatchEvent(new CustomEvent("galedi:hero-done"));
			return;
		}

		let hasPlayed = false;

		function playEntrance() {
			if (hasPlayed) return;
			hasPlayed = true;

			const tl = gsap.timeline({
				onComplete: () => {
					section!.classList.add("hero-revealed");
					window.dispatchEvent(new CustomEvent("galedi:hero-done"));
				},
			});

			tl.fromTo(
				heading,
				{ opacity: 0, y: 35, filter: "blur(12px)", force3D: true },
				{
					opacity: 1,
					y: 0,
					filter: "blur(0px)",
					duration: 1.15,
					ease: "power3.out",
					force3D: true,
					onComplete: () => {
						heading.style.filter = "none";
					},
					clearProps: "filter,transform",
				}
			)
				.fromTo(
					desc,
					{ opacity: 0, y: 25, filter: "blur(10px)", force3D: true },
					{
						opacity: 1,
						y: 0,
						filter: "blur(0px)",
						duration: 1.05,
						ease: "power3.out",
						force3D: true,
						onComplete: () => {
							desc.style.filter = "none";
						},
						clearProps: "filter,transform",
					},
					"-=0.9"
				)
				.fromTo(
					marquee,
					{ opacity: 0, y: 20, filter: "blur(8px)", force3D: true },
					{
						opacity: 1,
						y: 0,
						filter: "blur(0px)",
						duration: 0.95,
						ease: "power3.out",
						force3D: true,
						onComplete: () => {
							marquee.style.filter = "none";
						},
						clearProps: "filter,transform",
					},
					"-=0.8"
				)
				.fromTo(
					filmstrip,
					{ opacity: 0, y: 50, scale: 0.98, filter: "blur(14px)", force3D: true },
					{
						opacity: 1,
						y: 0,
						scale: 1,
						filter: "blur(0px)",
						duration: 1.3,
						ease: "power3.out",
						force3D: true,
						onComplete: () => {
							filmstrip.style.filter = "none";
						},
						clearProps: "filter,transform",
					},
					"-=0.8"
				);
		}

		function setupViewportTrigger() {
			if (hasPlayed) return;

			// Check if Hero is currently in the viewport
			const rect = section!.getBoundingClientRect();
			const inViewport = rect.top < window.innerHeight * 0.85 && rect.bottom > 0;

			if (inViewport) {
				playEntrance();
			} else {
				// Wait until user scrolls into the Hero section
				ScrollTrigger.create({
					trigger: section,
					start: "top 80%",
					once: true,
					onEnter: () => {
						playEntrance();
					},
				});
			}
		}

		const isPreloaderActive =
			!sessionStorage.getItem("galedi_visited") &&
			!document.documentElement.classList.contains("preloader-skipped") &&
			Boolean(document.getElementById("galedi-preloader"));

		if (!isPreloaderActive) {
			setupViewportTrigger();
		} else {
			// Initially hide hero elements with optical blur while preloader is running
			gsap.set([heading, desc, marquee, filmstrip], { opacity: 0, y: 35, filter: "blur(12px)" });

			let fallbackTimer: number | null = null;

			const onPreloaderDone = () => {
				if (fallbackTimer) {
					clearTimeout(fallbackTimer);
					fallbackTimer = null;
				}
				setupViewportTrigger();
			};

			window.addEventListener("galedi:preloader-done", onPreloaderDone, { once: true });

			fallbackTimer = window.setTimeout(() => {
				window.removeEventListener("galedi:preloader-done", onPreloaderDone);
				setupViewportTrigger();
			}, 3200);
		}
	}

	function initHero() {
		initHeroSwiper();
		initHeroEntrance();
	}

	// In Astro with ClientRouter, astro:page-load handles initial load + page transitions cleanly
	document.addEventListener("astro:page-load", initHero);
</script>
