---
import { Dot } from "@lucide/astro";
import ValuesCards from "./ValuesCards";
---

<section class="bg-primary_onyx min-h-max text-primary_bone_white font-testsohne w-full items-center justify-center py-40 px-5">
	<div class="grid grid-cols-[0.25fr_1fr] gap-25">
		<div class="flex items-center h-max gap-0.5">
			<Dot class="size-6 stroke-10" />
			<span class="text-2xl">About us</span>
		</div>
		<div class="flex flex-col gap-6 max-w-[1029px] w-full justify-self-center">
			<h2 class="italic text-3xl">Built to bring good businesses together</h2>
			<p class="text-2xl font-light text-justify leading-relaxed">
				Galedicorps is a multi-industry holding company focused on building and managing strong, market-leading businesses. Our portfolio spans 9 commercial brands and 3 digital media platforms across four core sectors.
			</p>
			<div class="w-full grid grid-cols-4 gap-2.5">
				<div class="flex flex-col gap-5">
					<div class="text-[64px]">
						<span>9</span>
						<span>+</span>
					</div>
					<span class="text-xl">Active Brands</span>
				</div>
				<div class="flex flex-col gap-5">
					<div class="text-[64px]">
						<span>3</span>
						<span>+</span>
					</div>
					<span class="text-xl">Media Platforms</span>
				</div>
				<div class="flex flex-col gap-5">
					<div class="text-[64px]">
						<span>4</span>
						<span>+</span>
					</div>
					<span class="text-xl">Core Strategic business</span>
				</div>
				<div class="flex flex-col gap-5">
					<div class="text-[64px]">
						<span>99.4</span>
						<span>%</span>
					</div>
					<span class="text-xl">Satisfaction Index</span>
				</div>
			</div>
		</div>
	</div>

	<!-- our values -->
	<div class="flex flex-col pt-[52px]">
		<div class="flex items-center pb-[52px] h-max gap-0.5 justify-self-center">
			<Dot class="size-6 stroke-10" />
			<span class="text-2xl">Our Values</span>
		</div>
		<ValuesCards client:visible />
	</div>
</section>