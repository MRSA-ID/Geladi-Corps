</div>

<script>
	import { initPreloader } from "../scripts/preloader";

	// Run preloader on initial page load only
	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initPreloader, { once: true });
	} else {
		initPreloader();
	}

	// Ensure preloader is immediately removed if re-inserted during client-side navigation
	document.addEventListener("astro:page-load", () => {
		if (sessionStorage.getItem("geladi_visited")) {
			const preloader = document.getElementById("geladi-preloader");
			if (preloader) {
				preloader.style.display = "none";
				preloader.remove();
			}
		}
	});
</script>
