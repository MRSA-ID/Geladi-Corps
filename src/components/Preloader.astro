---
// Zero-FOUC Initial Session Preloader with Minimalist Counter (0-100%) & Unified GalediCorps.svg Reveal
---

<!-- Zero-frame session check script (executes before HTML renders) -->
<script is:inline>
	if (typeof sessionStorage !== "undefined" && sessionStorage.getItem("galedi_visited")) {
		document.documentElement.classList.add("preloader-skipped");
	}
</script>

<!-- Fullscreen Initial Session Preloader -->
<div
	id="galedi-preloader"
	class="fixed inset-0 z-[9999] flex flex-col items-center justify-center select-none overflow-hidden"
	aria-hidden="true"
>
	<!-- Fullscreen Morphing SVG Curtain Canvas (Matches Page Transition Theme) -->
	<svg
		id="preloader-curtain-svg"
		class="absolute inset-0 w-full h-full pointer-events-none will-change-transform"
		viewBox="0 0 100 100"
		preserveAspectRatio="none"
	>
		<path
			id="preloader-curtain-path"
			fill="#1e1e1b"
			vector-effect="non-scaling-stroke"
			d="M 0 0 V 100 Q 50 100 100 100 V 0 z"
		/>
	</svg>

	<!-- Center Content Wrapper -->
	<div class="relative z-10 flex flex-col items-center justify-center w-full max-w-[88vw] px-6">
		<!-- 1. Pure Minimalist Progress Counter (0% to 100% - No Progress Bar) -->
		<div
			id="preloader-counter-container"
			class="flex items-baseline gap-1 font-testsohne will-change-transform absolute"
		>
			<span
				id="preloader-counter-val"
				class="text-7xl sm:text-8xl md:text-9xl font-semibold tracking-tighter text-primary_bone_white tabular-nums"
			>
				0
			</span>
			<span class="text-3xl sm:text-4xl md:text-5xl font-light text-neutral-400">
				%
			</span>
		</div>

		<!-- 2. Centered Galedi Corps SVG Wordmark Container (Masked for unified bottom reveal) -->
		<div
			id="preloader-wordmark-container"
			class="flex flex-col items-center justify-center w-[440px] sm:w-[580px] md:w-[700px] lg:w-[820px] overflow-hidden py-4 opacity-0 pointer-events-none"
		>
			<svg
