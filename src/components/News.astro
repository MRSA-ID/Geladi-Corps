---
import { Image } from "astro:assets";
import whiffMedia from "@assets/images/logo_brands/whiff_logo.png";
import ounceId from "@assets/images/logo_brands/8ounce_logo.png";
import nomadbookId from "@assets/images/logo_brands_black/nomadbookid_logo_black.png";

import newsWhiff from "@assets/images/news/whiff_news_sakaparfumery.jpg";
import newsNomadbookid from "@assets/images/news/nomadbook_news_tamarinhoteljakarta.jpg";
import news8ounce from "@assets/images/news/8ounceid_news_kesehatan_mental.jpg";
import { ArrowUpRight } from "@lucide/astro";

interface MediaItem {
	name: string;
	logo: ImageMetadata;
}

interface NewsItem {
	title: string;
	thumbnail: ImageMetadata;
	logo: ImageMetadata;
	date: string;
	link: string;
	objectPositionClass?: string;
}

const brandsMedia: MediaItem[] = [
	{ name: "Whiff Media brands media partner", logo: whiffMedia },
	{ name: "ounceId brands consulting", logo: ounceId },
	{ name: "Nomadbook Id brands consulting", logo: nomadbookId },
];

const newsMedia: NewsItem[] = [
	{
		title:
			"Last weekend with SAKA Downtown Series 2.0 x Andreas Prasetya good scents, good pipel, and a launch worth staying out for.",
		thumbnail: newsWhiff,
		logo: whiffMedia,
		date: "14/26",
		link: "https://www.instagram.com/whiff.media/",
		objectPositionClass: "object-center",
	},
	{
		title:
			"Heritage, hospitality, dan lokasi strategis — semua ada di Tamarin Hotel Jakarta",
		thumbnail: newsNomadbookid,
		logo: nomadbookId,
		date: "25/25",
		link: "https://www.nomadbookid.com/",
		objectPositionClass: "object-top",
	},
	{
		title:
			"Workplace yang sehat bukan hanya bebas dari risiko fisik, tapi juga mampu menjaga kesehatan mental setiap orang di dalamnya.",
		thumbnail: news8ounce,
		logo: ounceId,
		date: "04/26",
		link: "http://nirmalaofficial.com/8OUNCE/",
		objectPositionClass: "object-top",
	},
];
---

<style>
	/* Zero-FOUC hidden state before newsroom header reveals */
	#newsroom:not(.news-revealed) .news-header-title,
	#newsroom:not(.news-revealed) .news-header-logo {
		opacity: 0;
	}

	/* Zero-FOUC hidden state for individual news items until scrolled into view */
	.news-container-item:not(.news-item-revealed) {
		opacity: 0;
	}

	/* Clean static document state once revealed */
	#newsroom.news-revealed .news-header-title,
	#newsroom.news-revealed .news-header-logo,
	.news-container-item.news-item-revealed {
		opacity: 1;
		transform: none !important;
	}
</style>

<section
	id="newsroom"
	class="relative bg-white font-testsohne min-h-screen py-24 sm:py-32 px-2.5 sm:px-8 lg:px-12 overflow-hidden"
>
	<!-- Floating Custom Follower Cursor Badge with ArrowUpRight Icon -->
	<div
		id="news-cursor-badge"
		class="pointer-events-none fixed top-0 left-0 z-50 hidden lg:flex size-16 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-primary_onyx text-primary_bone_white shadow-2xl opacity-0 scale-75 transition-[opacity,transform] duration-200 ease-out"
	>
		<ArrowUpRight class="size-7 stroke-[2]" />
	</div>

	<div class="w-full flex flex-col">
		<!-- Section Header -->
		<div
			class="w-full flex flex-col md:flex-row md:items-center justify-between gap-8 pb-9 sm:pb-24"
		>
			<h1
				class="news-header-title font-semibold text-5xl sm:text-6xl md:text-7xl text-primary_onyx tracking-tight backface-hidden transform-[translateZ(0)]"
			>
				Newsroom
			</h1>
			<div class="flex flex-wrap gap-4 sm:gap-6 justify-center md:justify-end">
				{
					brandsMedia.map((media) => (
						<Image
							src={media.logo}
							alt={media.name}
							width={350}
							height={150}
							format="webp"
							quality={95}
							densities={[1, 2]}
							loading="lazy"
							decoding="async"
							class="news-header-logo size-[140px] sm:size-[150px] object-contain select-none backface-hidden transform-[translateZ(0)]"
						/>
					))
				}
			</div>
		</div>

		<!-- News Items List -->
		<div class="flex flex-col w-full">
			{
				newsMedia.map((media, idx) => (
					<a
						id={"container_news_" + idx}
						href={media.link}
						target="_blank"
						rel="noopener noreferrer"
						class="news-container-item group block w-full border-t border-primary_onyx pt-8 pb-12 sm:pb-16 transition-colors duration-300 lg:cursor-none select-none backface-hidden transform-[translateZ(0)]"
					>
						<div class="w-full grid grid-cols-1 lg:grid-cols-[0.75fr_1fr_0.25fr] gap-6 sm:gap-8 lg:gap-[25px] items-start">
							{/* Thumbnail Image Container */}
							<div class="h-[360px] sm:h-[440px] lg:h-[500px] w-full overflow-hidden bg-neutral-100">
								<Image
									src={media.thumbnail}
									alt={media.title}
									width={1080}
									height={1400}
									format="webp"
									quality={90}
									densities={[1, 2]}
									loading="lazy"
									decoding="async"
									class:list={[
										"h-full w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.23,1,0.32,1)] group-hover:scale-105",
										media.objectPositionClass || "object-center",
									]}
								/>
							</div>

							{/* News Info & Partner Brand Logo */}
							<div class="font-normal flex flex-col justify-between h-full min-h-[220px] lg:min-h-[480px] py-1">
								<h2 class="text-2xl sm:text-3xl lg:text-4xl text-primary_onyx leading-snug font-normal transition-colors duration-300">
									{media.title}
								</h2>
								<div class="flex gap-4 items-center mt-auto pt-6">
									<Image
										src={media.logo}
										alt={"logo brands media partner"}
										width={350}
										height={100}
										format="webp"
										quality={90}
										class="w-[70px] sm:w-[80px] h-[70px] sm:h-[80px] object-contain select-none"
									/>
									<span class="text-base sm:text-lg text-primary_onyx tracking-wider">
										{media.date}
									</span>
								</div>
							</div>

							{/* Action Indicator Icon */}
							<div class="hidden lg:flex justify-end pt-2">
								<div class="p-1 rounded-full flex items-center justify-center transition-all duration-300 group-hover:border-primary_onyx group-hover:bg-primary_onyx group-hover:text-primary_bone_white">
									<ArrowUpRight class="size-[72px] stroke-[1.5] transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
								</div>
							</div>
						</div>
					</a>
				))
			}
		</div>
	</div>
</section>

<script>
	import gsap from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	function initNewsEntrance() {
		const section = document.getElementById("newsroom");
		if (!section) return;

		const heading = section.querySelector(".news-header-title");
		const logos = section.querySelectorAll(".news-header-logo");
		const newsItems = section.querySelectorAll(".news-container-item");

		if (!heading || !newsItems.length) return;

		// Abort existing tweens and triggers
		gsap.killTweensOf([heading, ...Array.from(logos), ...Array.from(newsItems)]);
		ScrollTrigger.getAll().forEach((trigger) => {
			if (trigger.vars.id?.startsWith("news-")) {
				trigger.kill();
			}
		});

		const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		if (prefersReducedMotion) {
			section.classList.add("news-revealed");
			newsItems.forEach((item) => item.classList.add("news-item-revealed"));
			gsap.set([heading, ...Array.from(logos), ...Array.from(newsItems)], { opacity: 1, y: 0 });
			return;
		}

		// 1. Header Entrance Timeline
		let headerPlayed = false;
		function playHeaderEntrance() {
			if (headerPlayed) return;
			headerPlayed = true;

			const tl = gsap.timeline({
				onComplete: () => {
					section!.classList.add("news-revealed");
				},
			});

			tl.fromTo(
				heading,
				{ opacity: 0, y: 40, force3D: true },
				{
					opacity: 1,
					y: 0,
					duration: 1.1,
					ease: "power3.out",
					force3D: true,
					clearProps: "transform",
				}
			);

			if (logos.length) {
				tl.fromTo(
					logos,
					{ opacity: 0, y: 25, force3D: true },
					{
						opacity: 1,
						y: 0,
						duration: 0.95,
						stagger: 0.1,
						ease: "power3.out",
						force3D: true,
						clearProps: "transform",
					},
					"-=0.8"
				);
			}
		}

		// Check if news header is already in view or scrolled past on initial mount
		const sectionRect = section.getBoundingClientRect();
		if (sectionRect.top < window.innerHeight * 0.9) {
			playHeaderEntrance();
		} else {
			ScrollTrigger.create({
				id: "news-header-trigger",
				trigger: section,
				start: "top 70%",
				once: true,
				onEnter: playHeaderEntrance,
				onRefresh: (self) => {
					if (self.progress > 0 || (self.trigger && self.trigger.getBoundingClientRect().top < window.innerHeight * 0.9)) {
						playHeaderEntrance();
					}
				},
			});
		}

		// 2. Individual News Item ScrollTrigger Reveals (revealed on scroll per item)
		newsItems.forEach((item, idx) => {
			const itemRect = item.getBoundingClientRect();
			if (itemRect.top < window.innerHeight * 0.95) {
				item.classList.add("news-item-revealed");
				gsap.fromTo(
					item,
					{ opacity: 0, y: 35, force3D: true },
					{
						opacity: 1,
						y: 0,
						duration: 0.85,
						ease: "power3.out",
						force3D: true,
						clearProps: "transform",
					}
				);
			} else {
				gsap.fromTo(
					item,
					{ opacity: 0, y: 50, force3D: true },
					{
						opacity: 1,
						y: 0,
						duration: 1.15,
						ease: "power3.out",
						force3D: true,
						clearProps: "transform",
						scrollTrigger: {
							id: `news-item-${idx}`,
							trigger: item,
							start: "top 85%",
							once: true,
							onEnter: () => {
								item.classList.add("news-item-revealed");
							},
							onRefresh: (self) => {
								if (self.progress > 0 || item.getBoundingClientRect().top < window.innerHeight * 0.95) {
									item.classList.add("news-item-revealed");
								}
							},
						},
					}
				);
			}
		});
	}

	function initNewsCursor() {
		// Only enable custom floating cursor on devices with fine pointer and hover capability
		if (
			!window.matchMedia("(hover: hover) and (pointer: fine)").matches ||
			window.innerWidth < 1024
		) {
			return;
		}

		const badge = document.getElementById("news-cursor-badge");
		const newsItems = document.querySelectorAll(".news-container-item");
		if (!badge || newsItems.length === 0) return;

		let mouseX = 0;
		let mouseY = 0;
		let currentX = 0;
		let currentY = 0;
		let isHovering = false;
		let isPressed = false;
		let rafId: number | null = null;

		function updateCursor() {
			if (isHovering) {
				// Smooth physics interpolation (LERP: 0.18 for responsiveness with silky settle)
				currentX += (mouseX - currentX) * 0.18;
				currentY += (mouseY - currentY) * 0.18;

				const scale = isPressed ? 0.9 : 1.0;
				badge!.style.transform = `translate3d(${currentX}px, ${currentY}px, 0) translate(-50%, -50%) scale(${scale})`;
			}
			rafId = requestAnimationFrame(updateCursor);
		}

		function onPointerMove(e: PointerEvent) {
			mouseX = e.clientX;
			mouseY = e.clientY;
			if (!isHovering) {
				currentX = mouseX;
				currentY = mouseY;
			}
		}

		function onPointerDown() {
			isPressed = true;
			badge!.style.transform = `translate3d(${currentX}px, ${currentY}px, 0) translate(-50%, -50%) scale(0.9)`;
		}

		function onPointerUp() {
			isPressed = false;
			badge!.style.transform = `translate3d(${currentX}px, ${currentY}px, 0) translate(-50%, -50%) scale(1.0)`;
		}

		window.addEventListener("pointermove", onPointerMove, { passive: true });
		window.addEventListener("pointerdown", onPointerDown, { passive: true });
		window.addEventListener("pointerup", onPointerUp, { passive: true });

		newsItems.forEach((item) => {
			item.addEventListener("mouseenter", () => {
				isHovering = true;
				badge.classList.remove("opacity-0", "scale-75");
				badge.classList.add("opacity-100", "scale-100");
			});

			item.addEventListener("mouseleave", () => {
				isHovering = false;
				badge.classList.remove("opacity-100", "scale-100");
				badge.classList.add("opacity-0", "scale-75");
			});
		});

		if (!rafId) {
			rafId = requestAnimationFrame(updateCursor);
		}
	}

	function initNews() {
		initNewsEntrance();
		initNewsCursor();
	}

	// In Astro with ClientRouter, astro:page-load handles initial load + page transitions cleanly
	document.addEventListener("astro:page-load", initNews);
</script>