---
import { Image } from "astro:assets";
import meetcation from "@assets/images/logo_brands/meetcation_logo_color.png";
import nirmala from "@assets/images/logo_brands/nirmala_logo_only_color.png";
import saka from "@assets/images/logo_brands/saka_logo_color.png";
import arkaloka from "@assets/images/logo_brands/arkaloka_logo_color.png";
import dusantara from "@assets/images/logo_brands/dusantara_logo.png";
import safeeya from "@assets/images/logo_brands/safeeyaumroh_logo_color.png";

interface BrandItem {
	name: string;
	logo: ImageMetadata;
}

const brands: BrandItem[] = [
	{ name: "Meetcation Tour & Travel", logo: meetcation },
	{ name: "Saka Perfumery", logo: saka },
	{ name: "Saka International", logo: saka },
	{ name: "Arkaloka Hospitality", logo: arkaloka },
	{ name: "Safeeya Umroh", logo: safeeya },
	{ name: "Saka Remedy", logo: saka },
	{ name: "Saka Ambient", logo: saka },
	{ name: "Nirmala Project", logo: nirmala },
	{ name: "Dusantara Heritage", logo: dusantara },
];
---

<style>
	/* Zero-FOUC hidden state before left sticky column reveals */
	#brands-section:not(.brands-revealed) .brands-title,
	#brands-section:not(.brands-revealed) .brands-desc {
		opacity: 0;
	}

	/* Clean static document state once revealed */
	#brands-section.brands-revealed .brands-title,
	#brands-section.brands-revealed .brands-desc {
		opacity: 1;
		transform: none !important;
	}
</style>

<section
	id="brands-section"
	class="relative brands-section font-testsohne bg-primary_limestone px-5 sm:px-8 lg:px-12 py-16 sm:py-24"
>
	<div
		class="max-w-[1400px] mx-auto grid grid-cols-1 lg:grid-cols-[0.8fr_1.2fr] gap-12 lg:gap-20 items-start"
	>
		<!-- Left Column: Sticky Pinned Vertically at Center of Viewport on Scroll -->
		<div
			class="brands-left-pinned lg:sticky lg:top-0 lg:h-screen lg:flex lg:flex-col lg:justify-center self-start flex flex-col gap-6 max-w-[500px] py-8 lg:py-0"
		>
			<h2
				class="brands-title font-testsohne font-semibold text-5xl sm:text-6xl md:text-7xl text-digital-neutrals-700 leading-[1.08] tracking-tight backface-hidden transform-[translateZ(0)]"
			>
				Our Brands
			</h2>
			<p
				class="brands-desc font-normal text-lg sm:text-xl md:text-2xl text-primary_onyx/85 leading-relaxed text-justify backface-hidden transform-[translateZ(0)]"
			>
				A curated portfolio of high-growth enterprises spanning Personal Care, Lifestyle & Fragrance, Travel & Hospitality, Experiential Events, and Human Capital Consulting.
			</p>
		</div>

		<!-- Right Column: 2-Column Staggered Brand Cards Streaming Upwards -->
		<div
			class="brands-cards-container grid grid-cols-1 sm:grid-cols-2 gap-6 w-full lg:pt-[1080px] pb-[360px]"
		>
			{
				brands.map((brand, idx) => (
					<div
						class:list={[
							"brand-card group relative bg-white rounded-[10px] p-6 sm:p-8 flex flex-col items-center justify-between border border-black/5 shadow-2xs transition-all duration-500 hover:shadow-xl hover:-translate-y-2 cursor-pointer aspect-[4/5] min-h-[300px] sm:min-h-[340px]",
							idx % 2 === 1 ? "brand-card-col2 sm:mt-10" : "brand-card-col1",
						]}
					>
						{/* Logo Area (150x150) */}
						<div class="my-auto flex items-center justify-center p-4">
							<Image
								src={brand.logo}
								alt={brand.name}
								width={150}
								height={150}
								format="webp"
								quality={95}
								densities={[1, 2]}
								loading="lazy"
								decoding="async"
								class="size-[140px] sm:size-[150px] object-cover select-none transition-transform duration-500"
							/>
						</div>

						{/* Brand Name Footer */}
						<div class="w-full text-center mt-auto pt-4">
							<h3 class="font-bold text-neutral-800 text-xl transition-colors duration-300 group-hover:text-secondary_olive">
								{brand.name}
							</h3>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>

<script>
	import gsap from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	function initBrandsScroll() {
		gsap.registerPlugin(ScrollTrigger);

		const section = document.querySelector("#brands-section") as HTMLElement;
		if (!section) return;

		const title = section.querySelector(".brands-title");
		const desc = section.querySelector(".brands-desc");

		ScrollTrigger.getAll().forEach((trigger) => {
			if (trigger.vars.id?.startsWith("brands-")) {
				trigger.kill();
			}
		});

		// 1. Background Color Scrub
		gsap.fromTo(
			section,
			{ backgroundColor: "#e8e1d8" },
			{
				backgroundColor: "#ffffff",
				ease: "none",
				scrollTrigger: {
					id: "brands-bg-scrub",
					trigger: section,
					start: "top top",
					end: "bottom bottom",
					scrub: true,
					invalidateOnRefresh: true,
				},
			}
		);

		// 2. Left Sticky Column Entrance Reveal
		if (title && desc) {
			gsap.killTweensOf([title, desc]);

			const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			if (prefersReducedMotion) {
				section.classList.add("brands-revealed");
				gsap.set([title, desc], { opacity: 1, y: 0 });
			} else {
				let hasPlayed = false;

				function playLeftColumnEntrance() {
					if (hasPlayed) return;
					hasPlayed = true;

					const tl = gsap.timeline({
						onComplete: () => {
							section.classList.add("brands-revealed");
						},
					});

					tl.fromTo(
						title,
						{ opacity: 0, y: 40, force3D: true },
						{
							opacity: 1,
							y: 0,
							duration: 1.1,
							ease: "power3.out",
							force3D: true,
							clearProps: "transform",
						}
					).fromTo(
						desc,
						{ opacity: 0, y: 30, force3D: true },
						{
							opacity: 1,
							y: 0,
							duration: 1.05,
							ease: "power3.out",
							force3D: true,
							clearProps: "transform",
						},
						"-=0.8"
					);
				}

				const sectionRect = section.getBoundingClientRect();
				if (sectionRect.top < window.innerHeight * 0.9) {
					playLeftColumnEntrance();
				} else {
					ScrollTrigger.create({
						id: "brands-left-reveal",
						trigger: section,
						start: "top 70%",
						once: true,
						onEnter: playLeftColumnEntrance,
						onRefresh: (self) => {
							if (self.progress > 0 || (self.trigger && self.trigger.getBoundingClientRect().top < window.innerHeight * 0.9)) {
								playLeftColumnEntrance();
							}
						},
					});
				}
			}
		}

		ScrollTrigger.refresh();
	}

	// In Astro with ClientRouter, astro:page-load handles initial load + page transitions cleanly
	document.addEventListener("astro:page-load", initBrandsScroll);
</script>