---
import { ClientRouter } from "astro:transitions";
import Preloader from "@components/Preloader.astro";
import PageTransition from "@components/PageTransition.astro";
import Navbar from "@components/Navbar.astro";
import Footer from "@components/Footer.astro";
import SonnerToaster from "@components/ui/SonnerToaster";
import "sonner/dist/styles.css";
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Geladi Corps | Corporate Holding & Strategic Ecosystem",
	description = "A multi-industry holding company managing 9 commercial brands and 2 digital media platforms across 5 core strategic industry sectors.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<!-- Favicon Suite & Webmanifest -->
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>

		<!-- Zero-FOUC Session Preloader Controller (Executes before HTML paint) -->
		<script is:inline>
			if (typeof sessionStorage !== "undefined" && sessionStorage.getItem("geladi_visited")) {
				document.documentElement.classList.add("preloader-skipped");
			}
		</script>
		<style is:inline>
			html.preloader-skipped #geladi-preloader {
				display: none !important;
				visibility: hidden !important;
				pointer-events: none !important;
			}
		</style>

		<!-- Astro Native ClientRouter for View Transitions -->
		<ClientRouter />
	</head>
	<body class="min-h-screen bg-primary_limestone font-sans antialiased">
		<!-- Initial Session Preloader -->
		<Preloader />

		<!-- Page Transition Overlay -->
		<PageTransition />

		<!-- Fixed Smart Auto-Hiding Navbar & Fullscreen Mobile Menu -->
		<Navbar />

		<slot />

		<Footer />
		<SonnerToaster client:load />

		<script>
			import gsap from "gsap";
			import { ScrollTrigger } from "gsap/ScrollTrigger";
			import { initLenis, scrollToTarget, getLenis } from "../scripts/lenis";

			gsap.registerPlugin(ScrollTrigger);

			let isNavHidden = false;
			let scrollIdleTimeout: number | null = null;

			function updateNavbarVisibility(scroll: number) {
				const navContainer = document.getElementById("navbar-container");
				if (!navContainer) return;

				// Guard: check if mobile menu is open
				const mobileMenu = document.getElementById("mobile-fullscreen-menu");
				const isMobileMenuOpen = mobileMenu && !mobileMenu.classList.contains("opacity-0");

				// Guard: check if desktop mega menu is open
				const ecoPanel = document.getElementById("mega-menu-ecosystem");
				const brandsPanel = document.getElementById("mega-menu-brands");
				const isMegaMenuOpen =
					(ecoPanel && !ecoPanel.classList.contains("opacity-0")) ||
					(brandsPanel && !brandsPanel.classList.contains("opacity-0"));

				if (isMobileMenuOpen || isMegaMenuOpen) {
					if (isNavHidden) {
						gsap.to(navContainer, {
							y: 0,
							opacity: 1,
							duration: 0.25,
							ease: "power3.out",
							overwrite: "auto",
						});
						isNavHidden = false;
					}
					return;
				}

				// Always show at the very top of the page
				if (scroll <= 50) {
					if (scrollIdleTimeout) {
						clearTimeout(scrollIdleTimeout);
						scrollIdleTimeout = null;
					}
					if (isNavHidden) {
						gsap.to(navContainer, {
							y: 0,
							opacity: 1,
							duration: 0.35,
							ease: "power3.out",
							overwrite: "auto",
						});
						isNavHidden = false;
					}
					return;
				}

				// Active Scrolling: HIDE navbar immediately while scrolling
				if (!isNavHidden) {
					gsap.to(navContainer, {
						y: -90,
						opacity: 0,
						duration: 0.25,
						ease: "power2.inOut",
						overwrite: "auto",
					});
					isNavHidden = true;
				}

				// Debounce: when scrolling stops (idle pause), REVEAL navbar
				if (scrollIdleTimeout) {
					clearTimeout(scrollIdleTimeout);
				}
				scrollIdleTimeout = window.setTimeout(() => {
					gsap.to(navContainer, {
						y: 0,
						opacity: 1,
						duration: 0.35,
						ease: "power3.out",
						overwrite: "auto",
					});
					isNavHidden = false;
				}, 180);
			}

			function handleInitialHashScroll() {
				if (window.location.hash) {
					// Wait for page transition wave to clear before scrolling to target
					setTimeout(() => {
						const targetEl = document.querySelector(window.location.hash);
						if (targetEl) {
							scrollToTarget(targetEl as HTMLElement, { offset: -90, duration: 1.3 });
						}
					}, 400);
				}
			}

			function initGlobalLayout() {
				const lenis = initLenis();

				// Synchronize Lenis scroll with Smart Navbar Visibility
				lenis.on("scroll", ({ scroll }: { scroll: number }) => {
					updateNavbarVisibility(scroll);
				});

				// Handle initial URL hash landing
				handleInitialHashScroll();
			}

			// Capture-Phase Global Event Delegation for all Same-Page Hash Links (Prevents Astro router interference)
			document.addEventListener(
				"click",
				(e: MouseEvent) => {
					const anchor = (e.target as HTMLElement)?.closest("a");
					if (!anchor) return;

					const href = anchor.getAttribute("href");
					if (!href || href === "#") return;

					try {
						const targetUrl = new URL(anchor.href, window.location.href);
						const currentUrl = new URL(window.location.href);

						// Check if target is on the exact same page with a hash
						const isSameOrigin = targetUrl.origin === currentUrl.origin;
						const isSamePath =
							targetUrl.pathname.replace(/\/$/, "") === currentUrl.pathname.replace(/\/$/, "");
						const hasHash = Boolean(targetUrl.hash);

						if (isSameOrigin && isSamePath && hasHash) {
							const hashTarget = targetUrl.hash;
							const targetElement = document.querySelector(hashTarget);

							if (targetElement) {
								e.preventDefault();
								e.stopImmediatePropagation();

								// Close mobile menu if open
								const mobileMenu = document.getElementById("mobile-fullscreen-menu");
								if (mobileMenu && !mobileMenu.classList.contains("opacity-0")) {
									const closeBtn = document.getElementById("mobile-menu-close-btn");
									closeBtn?.click();
								}

								// Smoothly scroll using Lenis
								scrollToTarget(targetElement as HTMLElement, { offset: -90, duration: 1.2 });

								// Update URL hash in history without triggering browser jump
								window.history.pushState(null, "", hashTarget);
							}
						}
					} catch {
						// Fallback for non-standard URLs
					}
				},
				{ capture: true }
			);

			// Handle browser Back / Forward navigation between same-page hashes
			window.addEventListener("popstate", () => {
				if (window.location.hash) {
					const targetEl = document.querySelector(window.location.hash);
					if (targetEl) {
						scrollToTarget(targetEl as HTMLElement, { offset: -90, duration: 1.0 });
					}
				}
			});

			document.addEventListener("astro:page-load", initGlobalLayout);
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}
</style>
