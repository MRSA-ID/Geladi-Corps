---
import Layout from "../layouts/Layout.astro";
import OfficeMap from "@components/OfficeMap";
import ContactForm from "@components/ContactForm";
---

<style>
	/* Zero-FOUC hidden state before connect page reveals (pure opacity to eliminate CSS-JS filter fighting) */
	#connect-main:not(.connect-revealed) .connect-indicator,
	#connect-main:not(.connect-revealed) .connect-headline,
	#connect-main:not(.connect-revealed) .connect-narrative,
	#connect-main:not(.connect-revealed) .connect-left-col,
	#connect-main:not(.connect-revealed) .connect-right-form {
		opacity: 0;
	}

	#connect-main:not(.connect-revealed) .connect-header-divider {
		transform: scaleX(0);
		opacity: 0;
	}

	/* Clean static document state once revealed */
	#connect-main.connect-revealed .connect-indicator,
	#connect-main.connect-revealed .connect-headline,
	#connect-main.connect-revealed .connect-narrative,
	#connect-main.connect-revealed .connect-left-col,
	#connect-main.connect-revealed .connect-right-form {
		opacity: 1;
		transform: none !important;
		filter: none !important;
	}

	#connect-main.connect-revealed .connect-header-divider {
		transform: scaleX(1) !important;
		opacity: 1 !important;
	}
</style>

<Layout
	title="Contact Us | Galedi Corps"
	description="Connect with Galedi Corps for general inquiries, strategic brand partnerships, and enterprise business solutions."
>
	<main id="connect-main" class="min-h-screen bg-white text-primary_onyx pt-28 sm:pt-36 pb-28 px-5 sm:px-10 lg:px-16 font-testsohne">
		<div class="max-w-[1400px] mx-auto">
			<!-- Top Header: Indicator Bar, Massive Headline & Narrative -->
			<div class="connect-header relative flex flex-col gap-6 pb-16 sm:pb-24">
				<!-- Graphic Bar Indicator + Label (Matching Reference) -->
				<div class="connect-indicator flex items-center gap-2 backface-hidden transform-[translateZ(0)]">
					<div class="flex items-center gap-1">
						<span class="w-7 h-2.5 bg-neutral-400 rounded-xs"></span>
						<span class="w-3.5 h-2.5 bg-neutral-400 rounded-xs"></span>
						<span class="w-1.5 h-2.5 bg-neutral-400 rounded-xs"></span>
					</div>
					<span class="text-xs sm:text-sm font-medium tracking-wide text-neutral-600">Contact</span>
				</div>

				<!-- Headline + Right Narrative Grid -->
				<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end justify-between">
					<div class="lg:col-span-8">
						<h1 class="connect-headline text-6xl sm:text-7xl md:text-8xl lg:text-[104px] font-semibold text-primary_onyx tracking-tight leading-[0.98] backface-hidden transform-[translateZ(0)]">
							Contact Us
						</h1>
					</div>
					<div class="lg:col-span-4 lg:pl-4">
						<p class="connect-narrative text-base sm:text-lg md:text-xl text-neutral-600 font-light leading-relaxed backface-hidden transform-[translateZ(0)]">
							Explore ideas, strategies, and creative insights that help brands grow and digital experiences stand out across our holding ecosystem.
						</p>
					</div>
				</div>

				<!-- Animated Bottom Border Divider Line -->
				<div class="connect-header-divider absolute bottom-0 left-0 right-0 w-full h-[1px] bg-black/15 origin-left backface-hidden transform-[translateZ(0)] pointer-events-none"></div>
			</div>

			<!-- Two-Column Editorial Content & Form Grid -->
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 pt-16 sm:pt-20 items-start">
				<!-- Left Column: Institutional Information & Solutions -->
				<div class="connect-left-col lg:col-span-4 flex flex-col gap-10 backface-hidden transform-[translateZ(0)]">
					<!-- 1. Office Location -->
					<div class="flex flex-col gap-3.5">
						<div class="flex flex-col gap-1.5">
							<h3 class="text-xs font-semibold uppercase tracking-widest text-neutral-400">
								Office Location
							</h3>
							<p class="text-base sm:text-lg font-normal text-primary_onyx leading-relaxed">
								Jl. KH. Wahid Hasyim No. 77, <br />
								Menteng, Jakarta Pusat 10350, Indonesia
							</p>
						</div>

						<!-- Mapcn Interactive Map Preview -->
						<OfficeMap client:visible />
					</div>

					<!-- 2. Office Time -->
					<div class="flex flex-col gap-1.5">
						<h3 class="text-xs font-semibold uppercase tracking-widest text-neutral-400">
							Office Time
						</h3>
						<p class="text-base sm:text-lg font-normal text-primary_onyx leading-relaxed">
							Monday – Friday <br />
							09:00 – 18:00 WIB
						</p>
					</div>

					<!-- 3. Support & Channels -->
					<div class="flex flex-col gap-1.5">
						<h3 class="text-xs font-semibold uppercase tracking-widest text-neutral-400">
							Support & Channels
						</h3>
						<div class="flex flex-col gap-1 text-base sm:text-lg font-normal text-primary_onyx">
							<a href="mailto:info@galedicorps.com" class="hover:text-secondary_olive transition-colors w-max">
								info@galedicorps.com
							</a>
							<a href="tel:+6281381795665" class="hover:text-secondary_olive transition-colors w-max">
								+62 813-8179-5665
							</a>
						</div>
					</div>

					<hr class="border-black/10 my-1" />

					<!-- 4. Partnership Value & Models -->
					<div class="flex flex-col gap-2">
						<h3 class="text-xs font-semibold uppercase tracking-widest text-neutral-400">
							Strategic Partnerships
						</h3>
						<ul class="flex flex-col gap-2 text-sm sm:text-base font-light text-neutral-700">
							<li class="flex items-center gap-2">
								<span class="size-1.5 rounded-full bg-secondary_olive shrink-0"></span>
								<span>Brand Incubation & Joint Ventures</span>
							</li>
							<li class="flex items-center gap-2">
								<span class="size-1.5 rounded-full bg-secondary_olive shrink-0"></span>
								<span>Global Retail & Distribution Network</span>
							</li>
							<li class="flex items-center gap-2">
								<span class="size-1.5 rounded-full bg-secondary_olive shrink-0"></span>
								<span>Co-Branding & Media Activations</span>
							</li>
						</ul>
					</div>

					<!-- 5. Commercial Enterprise Solutions -->
					<div class="flex flex-col gap-2">
						<h3 class="text-xs font-semibold uppercase tracking-widest text-neutral-400">
							Enterprise Solutions
						</h3>
						<ul class="flex flex-col gap-2 text-sm sm:text-base font-light text-neutral-700">
							<li class="flex items-center gap-2">
								<span class="size-1.5 rounded-full bg-secondary_olive shrink-0"></span>
								<span>Corporate Travel & MICE Retreats</span>
							</li>
							<li class="flex items-center gap-2">
								<span class="size-1.5 rounded-full bg-secondary_olive shrink-0"></span>
								<span>OEM Fragrance & Scent Branding</span>
							</li>
							<li class="flex items-center gap-2">
								<span class="size-1.5 rounded-full bg-secondary_olive shrink-0"></span>
								<span>Events & Custom Packaging Fabrication</span>
							</li>
							<li class="flex items-center gap-2">
								<span class="size-1.5 rounded-full bg-secondary_olive shrink-0"></span>
								<span>Human Capital & Corporate Training</span>
							</li>
						</ul>
					</div>
				</div>

				<!-- Right Column: Minimalist Line-Underlined Form with Contextual Validation -->
				<div class="connect-right-form lg:col-span-8 backface-hidden transform-[translateZ(0)]">
					<ContactForm client:load />
				</div>
			</div>
		</div>
	</main>
</Layout>

<script>
	import gsap from "gsap";

	let activeConnectTimeline: gsap.core.Timeline | null = null;

	function initConnectEntrance() {
		const main = document.getElementById("connect-main");
		if (!main) return;

		const indicator = main.querySelector(".connect-indicator");
		const headline = main.querySelector(".connect-headline");
		const narrative = main.querySelector(".connect-narrative");
		const divider = main.querySelector(".connect-header-divider");
		const leftCol = main.querySelector(".connect-left-col");
		const rightForm = main.querySelector(".connect-right-form");

		const elements = [indicator, headline, narrative, divider, leftCol, rightForm].filter(Boolean) as HTMLElement[];
		if (!elements.length) return;

		if (activeConnectTimeline) {
			activeConnectTimeline.kill();
			activeConnectTimeline = null;
		}
		gsap.killTweensOf(elements);

		const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		if (prefersReducedMotion) {
			main.classList.add("connect-revealed");
			elements.forEach((el) => {
				if (el === divider) {
					el.style.transform = "scaleX(1)";
					el.style.opacity = "1";
				} else {
					el.style.filter = "none";
					el.style.transform = "none";
					el.style.opacity = "1";
				}
			});
			return;
		}

		// Calculate precise start delay: wait for page transition curtain if active, else clean settling delay
		const svgTransition = document.getElementById("page-transition-svg");
		const isPageTransitionActive = svgTransition && svgTransition.style.display !== "none";
		const startDelay = isPageTransitionActive ? 0.45 : 0.12;

		const tl = gsap.timeline({
			delay: startDelay,
			onComplete: () => {
				main.classList.add("connect-revealed");
				elements.forEach((el) => {
					if (el === divider) {
						el.style.transform = "scaleX(1)";
						el.style.opacity = "1";
					} else {
						el.style.filter = "none";
						el.style.transform = "none";
					}
				});
				activeConnectTimeline = null;
			},
		});
		activeConnectTimeline = tl;

		if (indicator) {
			tl.fromTo(
				indicator,
				{ opacity: 0, y: 20, filter: "blur(8px)", force3D: true },
				{
					opacity: 1,
					y: 0,
					filter: "blur(0px)",
					duration: 0.85,
					ease: "power3.out",
					force3D: true,
					clearProps: "transform,filter",
				}
			);
		}

		if (headline) {
			tl.fromTo(
				headline,
				{ opacity: 0, y: 35, filter: "blur(12px)", force3D: true },
				{
					opacity: 1,
					y: 0,
					filter: "blur(0px)",
					duration: 1.15,
					ease: "power3.out",
					force3D: true,
					clearProps: "transform,filter",
				},
				"-=0.65"
			);
		}

		if (narrative) {
			tl.fromTo(
				narrative,
				{ opacity: 0, y: 25, filter: "blur(10px)", force3D: true },
				{
					opacity: 1,
					y: 0,
					filter: "blur(0px)",
					duration: 1.05,
					ease: "power3.out",
					force3D: true,
					clearProps: "transform,filter",
				},
				"-=0.80"
			);
		}

		if (divider) {
			tl.fromTo(
				divider,
				{ scaleX: 0, opacity: 0, transformOrigin: "left center", force3D: true },
				{
					scaleX: 1,
					opacity: 1,
					duration: 1.15,
					ease: "power3.inOut",
					force3D: true,
				},
				"-=0.75"
			);
		}

		if (leftCol) {
			tl.fromTo(
				leftCol,
				{ opacity: 0, y: 40, filter: "blur(10px)", force3D: true },
				{
					opacity: 1,
					y: 0,
					filter: "blur(0px)",
					duration: 1.15,
					ease: "power3.out",
					force3D: true,
					clearProps: "transform,filter",
				},
				"-=0.70"
			);
		}

		if (rightForm) {
			tl.fromTo(
				rightForm,
				{ opacity: 0, y: 45, filter: "blur(10px)", force3D: true },
				{
					opacity: 1,
					y: 0,
					filter: "blur(0px)",
					duration: 1.2,
					ease: "power3.out",
					force3D: true,
					clearProps: "transform,filter",
				},
				"-=0.85"
			);
		}
	}

	document.addEventListener("astro:page-load", initConnectEntrance);
</script>
