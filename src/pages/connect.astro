---
import Layout from "../layouts/Layout.astro";
import { ArrowUpRight } from "@lucide/astro";
---

<Layout
	title="Contact Us | Galedi Corps"
	description="Connect with Galedi Corps for general inquiries, strategic brand partnerships, and enterprise business solutions."
>
	<main class="min-h-screen bg-white text-primary_onyx pt-28 sm:pt-36 pb-28 px-5 sm:px-10 lg:px-16 font-testsohne">
		<div class="max-w-[1400px] mx-auto">
			<!-- Top Header: Indicator Bar, Massive Headline & Narrative -->
			<div class="flex flex-col gap-6 pb-16 sm:pb-24 border-b border-black/10">
				<!-- Graphic Bar Indicator + Label (Matching Reference) -->
				<div class="flex items-center gap-2">
					<div class="flex items-center gap-1">
						<span class="w-7 h-2.5 bg-neutral-400 rounded-xs"></span>
						<span class="w-3.5 h-2.5 bg-neutral-400 rounded-xs"></span>
						<span class="w-1.5 h-2.5 bg-neutral-400 rounded-xs"></span>
					</div>
					<span class="text-xs sm:text-sm font-medium tracking-wide text-neutral-600">Contact</span>
				</div>

				<!-- Headline + Right Narrative Grid -->
				<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end justify-between">
					<div class="lg:col-span-8">
						<h1 class="text-6xl sm:text-7xl md:text-8xl lg:text-[104px] font-semibold text-primary_onyx tracking-tight leading-[0.98]">
							Contact Us
						</h1>
					</div>
					<div class="lg:col-span-4 lg:pl-4">
						<p class="text-base sm:text-lg md:text-xl text-neutral-600 font-light leading-relaxed">
							Explore ideas, strategies, and creative insights that help brands grow and digital experiences stand out across our holding ecosystem.
						</p>
					</div>
				</div>
			</div>

			<!-- Two-Column Editorial Content & Form Grid -->
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 pt-16 sm:pt-20 items-start">
				<!-- Left Column: Institutional Information & Solutions -->
				<div class="lg:col-span-4 flex flex-col gap-10">
					<!-- 1. Office Location -->
					<div class="flex flex-col gap-1.5">
						<h3 class="text-xs font-semibold uppercase tracking-widest text-neutral-400">
							Office Location
						</h3>
						<p class="text-base sm:text-lg font-normal text-primary_onyx leading-relaxed">
							Jl. KH. Wahid Hasyim No. 77, <br />
							Menteng, Jakarta Pusat 10350, Indonesia
						</p>
					</div>

					<!-- 2. Office Time -->
					<div class="flex flex-col gap-1.5">
						<h3 class="text-xs font-semibold uppercase tracking-widest text-neutral-400">
							Office Time
						</h3>
						<p class="text-base sm:text-lg font-normal text-primary_onyx leading-relaxed">
							Monday – Friday <br />
							09:00 – 18:00 WIB
						</p>
					</div>

					<!-- 3. Support & Channels -->
					<div class="flex flex-col gap-1.5">
						<h3 class="text-xs font-semibold uppercase tracking-widest text-neutral-400">
							Support & Channels
						</h3>
						<div class="flex flex-col gap-1 text-base sm:text-lg font-normal text-primary_onyx">
							<a href="mailto:info@galedicorps.com" class="hover:text-secondary_olive transition-colors w-max">
								info@galedicorps.com
							</a>
							<a href="mailto:media@galedicorps.com" class="text-sm text-neutral-600 hover:text-secondary_olive transition-colors w-max">
								Press: media@galedicorps.com
							</a>
							<a href="mailto:careers@galedicorps.com" class="text-sm text-neutral-600 hover:text-secondary_olive transition-colors w-max">
								Careers: careers@galedicorps.com
							</a>
						</div>
					</div>

					<hr class="border-black/10 my-1" />

					<!-- 4. Partnership Value & Models -->
					<div class="flex flex-col gap-2">
						<h3 class="text-xs font-semibold uppercase tracking-widest text-neutral-400">
							Strategic Partnerships
						</h3>
						<ul class="flex flex-col gap-2 text-sm sm:text-base font-light text-neutral-700">
							<li class="flex items-center gap-2">
								<span class="size-1.5 rounded-full bg-secondary_olive shrink-0"></span>
								<span>Brand Incubation & Joint Ventures</span>
							</li>
							<li class="flex items-center gap-2">
								<span class="size-1.5 rounded-full bg-secondary_olive shrink-0"></span>
								<span>Global Retail & Distribution Network</span>
							</li>
							<li class="flex items-center gap-2">
								<span class="size-1.5 rounded-full bg-secondary_olive shrink-0"></span>
								<span>Co-Branding & Media Activations</span>
							</li>
						</ul>
					</div>

					<!-- 5. Commercial Enterprise Solutions -->
					<div class="flex flex-col gap-2">
						<h3 class="text-xs font-semibold uppercase tracking-widest text-neutral-400">
							Enterprise Solutions
						</h3>
						<ul class="flex flex-col gap-2 text-sm sm:text-base font-light text-neutral-700">
							<li class="flex items-center gap-2">
								<span class="size-1.5 rounded-full bg-secondary_olive shrink-0"></span>
								<span>Corporate Travel & MICE Retreats</span>
							</li>
							<li class="flex items-center gap-2">
								<span class="size-1.5 rounded-full bg-secondary_olive shrink-0"></span>
								<span>OEM Fragrance & Scent Branding</span>
							</li>
							<li class="flex items-center gap-2">
								<span class="size-1.5 rounded-full bg-secondary_olive shrink-0"></span>
								<span>Events & Custom Packaging Fabrication</span>
							</li>
							<li class="flex items-center gap-2">
								<span class="size-1.5 rounded-full bg-secondary_olive shrink-0"></span>
								<span>Human Capital & Corporate Training</span>
							</li>
						</ul>
					</div>
				</div>

				<!-- Right Column: Minimalist Line-Underlined Form -->
				<div class="lg:col-span-8">
					<form class="flex flex-col gap-10 sm:gap-12">
						<!-- Row 1: Name & Email -->
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-8 sm:gap-12">
							<div class="flex flex-col gap-2">
								<label class="text-sm sm:text-base text-neutral-600 font-light">Enter your name *</label>
								<input
									type="text"
									required
									placeholder="e.g. Amanda Putri"
									class="w-full bg-transparent border-0 border-b border-black/20 pb-3 pt-1 text-base sm:text-lg text-primary_onyx placeholder:text-neutral-300 focus:outline-hidden focus:border-primary_onyx transition-colors duration-200"
								/>
							</div>
							<div class="flex flex-col gap-2">
								<label class="text-sm sm:text-base text-neutral-600 font-light">Email address *</label>
								<input
									type="email"
									required
									placeholder="amanda@example.com"
									class="w-full bg-transparent border-0 border-b border-black/20 pb-3 pt-1 text-base sm:text-lg text-primary_onyx placeholder:text-neutral-300 focus:outline-hidden focus:border-primary_onyx transition-colors duration-200"
								/>
							</div>
						</div>

						<!-- Row 2: Company & Phone -->
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-8 sm:gap-12">
							<div class="flex flex-col gap-2">
								<label class="text-sm sm:text-base text-neutral-600 font-light">Company name</label>
								<input
									type="text"
									placeholder="Company or Brand Name"
									class="w-full bg-transparent border-0 border-b border-black/20 pb-3 pt-1 text-base sm:text-lg text-primary_onyx placeholder:text-neutral-300 focus:outline-hidden focus:border-primary_onyx transition-colors duration-200"
								/>
							</div>
							<div class="flex flex-col gap-2">
								<label class="text-sm sm:text-base text-neutral-600 font-light">Phone number</label>
								<input
									type="tel"
									placeholder="+62 812-xxxx-xxxx"
									class="w-full bg-transparent border-0 border-b border-black/20 pb-3 pt-1 text-base sm:text-lg text-primary_onyx placeholder:text-neutral-300 focus:outline-hidden focus:border-primary_onyx transition-colors duration-200"
								/>
							</div>
						</div>

						<!-- Row 3: Inquiry Type -->
						<div class="flex flex-col gap-2">
							<label class="text-sm sm:text-base text-neutral-600 font-light">Inquiry Type *</label>
							<select
								id="inquiry-type-select"
								name="inquiry_type"
								required
								class="w-full bg-transparent border-0 border-b border-black/20 pb-3 pt-1 text-base sm:text-lg text-primary_onyx focus:outline-hidden focus:border-primary_onyx transition-colors duration-200 cursor-pointer"
							>
								<option value="" disabled selected>Select an inquiry or service type</option>
								<option value="general">General Corporate Inquiry</option>
								<option value="partnership">Strategic Brand Partnership & Incubation</option>
								<option value="mice">Corporate Travel & MICE Retreats (Meetcation / Safeeya)</option>
								<option value="scent">OEM Perfumery & Ambient Scenting (Saka / Arkaloka)</option>
								<option value="events">Event Production & Custom Packaging (Nirmala / Dusantara)</option>
								<option value="hr">Human Capital Consulting & Training (8ounce)</option>
								<option value="media">Media & Editorial Collaboration (Whiff Media)</option>
							</select>
						</div>

						<!-- Row 4: Your Message -->
						<div class="flex flex-col gap-2">
							<label class="text-sm sm:text-base text-neutral-600 font-light">Your message *</label>
							<textarea
								rows="4"
								required
								placeholder="Type your message, inquiry, or partnership details here..."
								class="w-full bg-transparent border-0 border-b border-black/20 pb-3 pt-1 text-base sm:text-lg text-primary_onyx placeholder:text-neutral-300 focus:outline-hidden focus:border-primary_onyx transition-colors duration-200 resize-none"
							></textarea>
						</div>

						<!-- Submit Button -->
						<div class="pt-4">
							<button
								type="submit"
								class="w-full sm:w-max px-10 py-4 rounded-full bg-primary_onyx hover:bg-neutral-800 text-primary_bone_white font-medium text-base sm:text-lg flex items-center justify-center gap-3 shadow-lg hover:shadow-xl active:scale-[0.98] transition-all duration-200 cursor-pointer group"
							>
								<span>Send Message</span>
								<ArrowUpRight class="size-5 stroke-[2] transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
							</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</main>
</Layout>

<script>
	function initInquiryAutoSelect() {
		const select = document.querySelector("#inquiry-type-select") as HTMLSelectElement | null;
		if (!select) return;

		const params = new URLSearchParams(window.location.search);
		const typeParam = (params.get("type") || window.location.hash.replace("#", "")).toLowerCase();

		if (typeParam === "partnership" || typeParam === "partnerships") {
			select.value = "partnership";
		} else if (typeParam === "inquiries" || typeParam === "inquiry" || typeParam === "business" || typeParam === "mice") {
			select.value = "mice";
		} else if (typeParam === "general" || typeParam === "contact") {
			select.value = "general";
		}
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initInquiryAutoSelect);
	} else {
		initInquiryAutoSelect();
	}
	document.addEventListener("astro:page-load", initInquiryAutoSelect);
</script>
