---

<style>
	/* Zero-FOUC initial hidden state before brands hero reveals */
	#hero-brands:not(.brands-hero-revealed) .brands-hero-title,
	#hero-brands:not(.brands-hero-revealed) .brands-hero-desc {
		opacity: 0;
	}

	/* Clean static document state once revealed */
	#hero-brands.brands-hero-revealed .brands-hero-title,
	#hero-brands.brands-hero-revealed .brands-hero-desc {
		opacity: 1;
		transform: none !important;
		filter: none !important;
	}
</style>

<Layout
	title="Our Brands & Ecosystem | Galedi Corps"
	description="Explore the comprehensive brand portfolio and multi-industry ecosystem of Galedi Corps across fragrance, travel, events, consulting, and media."
>
	<main class="w-full pb-[40vh] bg-white relative font-testsohne text-primary_onyx overflow-visible">
		<!-- Hero Section with Interactive Cursor Image Trail -->
		<section
			id="hero-brands"
			class="w-full min-h-screen flex flex-col justify-center px-5 sm:px-10 lg:px-16 pt-28 sm:pt-36 pb-12 relative overflow-hidden select-none cursor-default"
		>
			<!-- 1. Cursor Image Trail Container -->
			<div
				id="image-trail-container"
				class="absolute inset-0 pointer-events-none z-30 overflow-hidden"
				aria-hidden="true"
			>
				{
					trailImages.map((img) => (
						<div class="trail-item absolute top-0 left-0 w-44 sm:w-56 md:w-64 aspect-[4/3] rounded-2xl overflow-hidden shadow-2xl border border-black/10 bg-neutral-100 opacity-0 pointer-events-none select-none will-change-transform will-change-opacity -translate-x-1/2 -translate-y-1/2">
							<Image
								src={img.src}
								alt={img.alt}
								width={400}
								height={300}
								format="webp"
								quality={85}
								class="w-full h-full object-cover object-center pointer-events-none"
							/>
						</div>
					))
				}
			</div>

			<!-- 2. Hero Content (Elevated above trail for readability & interactivity) -->
			<div class="flex flex-col gap-6 relative z-20 pointer-events-auto">
				<div class="flex flex-col gap-8 items-center justify-center">
					<div class="text-center">
						<h1 class="brands-hero-title text-5xl sm:text-7xl md:text-8xl lg:text-[96px] font-semibold text-primary_onyx tracking-tight leading-[0.98] backface-hidden transform-[translateZ(0)]">
							Our Ecosystem <br class="hidden sm:inline" />& Brands
						</h1>
					</div>
					<div class="lg:pl-4 text-center">
						<p class="brands-hero-desc text-base max-w-2xl sm:text-lg md:text-xl text-neutral-600 font-light leading-relaxed backface-hidden transform-[translateZ(0)]">
							A multi-industry holding group managing 9 commercial brands and 2 digital media platforms across 5 core strategic industry sectors.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Stacked Pinned Header Cards Container -->
		<div id="stacked-cards-container" class="w-full relative pt-[10vh] pb-[60vh] bg-white">
			{
				categories.map((category, idx) => (
					<div class="card-track w-full mb-[40vh] last:mb-0">
						<section
							id={`category-${category.id}`}
							data-card-index={idx}
							class={`stacked-card w-full relative rounded-none flex flex-col pt-0 pb-6 px-0 select-none border-black/10 ${category.bgClass}`}
						>
							<!-- 1. Sticky Card Top Header Bar (Height: 52px desktop / 46px mobile) -->
							<div
								class="card-header-bar w-full px-5 sm:px-10 lg:px-16 flex items-center justify-between border-b border-black/10 bg-white shrink-0 z-20 box-border gap-4"
							>
								<div class="flex items-center gap-3 shrink-0 whitespace-nowrap">
									<span class="text-xs sm:text-sm font-semibold uppercase tracking-widest text-neutral-500">
										Pillar {category.categoryNumber}
									</span>
									<span class="w-1.5 h-1.5 rounded-full bg-neutral-300"></span>
									<span class="text-xs sm:text-sm font-medium text-neutral-600 hidden md:inline">
										{category.kicker}
									</span>
								</div>
								<h2 class="text-sm sm:text-base md:text-lg lg:text-xl font-semibold tracking-tight text-primary_onyx whitespace-nowrap truncate text-right">
									{category.title}
								</h2>
							</div>

							<!-- Card Body Container (Compact Natural Height) -->
							<div class="w-full px-5 sm:px-10 lg:px-16 py-4 sm:py-5 overflow-visible">
								<!-- 2. Numbered Sub-Pillars Horizontal Strip -->
								<div class="pb-3 mb-10 border-b border-black/10 grid grid-cols-1 sm:grid-cols-3 gap-2.5 sm:gap-4 items-baseline">
									{
										category.pillars.map((pillar) => (
											<div class="flex flex-col gap-0.5">
												<span class="text-xs font-semibold text-neutral-400 tracking-wider">
													{pillar.number}
												</span>
												<h3 class="text-lg sm:text-xl md:text-2xl lg:text-3xl font-semibold tracking-tight leading-none text-primary_onyx capitalize">
													{pillar.title}
												</h3>
											</div>
										))
									}
								</div>

								<!-- 3. Bottom 2-Column Content Grid: Left (Editorial + Brands) | Right (Showcase Image) -->
								<div class="grid grid-cols-1 lg:grid-cols-12 gap-5 lg:gap-8 items-start">
									<!-- Left Column (lg:col-span-7): Editorial + Brand Links Grid -->
									<div class="lg:col-span-7 flex flex-col justify-around gap-12">
										<div>
											<p class="text-xs sm:text-sm lg:text-base font-light leading-relaxed mb-3 text-justify text-neutral-700">
												{category.description}
											</p>

											<!-- Capabilities Tags -->
											<div class="flex flex-wrap gap-1.5 mb-3.5">
												{
													category.capabilities.map((cap) => (
														<span class="px-2.5 py-0.5 rounded-full text-[11px] sm:text-xs font-medium bg-black/5 border border-black/5 text-neutral-800">
															{cap}
														</span>
													))
												}
											</div>
										</div>

										<!-- Brand Entities Directory Cards -->
										<div class="flex flex-col gap-1.5">
											<h4 class="text-[11px] sm:text-xs font-semibold uppercase tracking-wider text-neutral-400">
												Brand Entities & Official Links
											</h4>
											<div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
												{
													category.brands.map((brand) => (
														<a
															href={brand.link}
															target="_blank"
															rel="noopener noreferrer"
															class={`group/brand bg-white hover:bg-neutral-50 text-primary_onyx rounded-[10px] p-2.5 sm:p-3 border border-black/10 shadow-2xs hover:shadow-md hover:-translate-y-0.5 active:scale-[0.98] transition-all flex flex-col justify-between gap-1.5 cursor-pointer ${
																category.brands.length === 1 ? "sm:col-span-2" : ""
															}`}
														>
															<div class="flex items-center justify-between">
																<div class="size-7 rounded-none bg-neutral-100 p-0.5 flex items-center justify-center overflow-hidden">
																	<Image
																		src={brand.logo}
																		alt={brand.name}
																		width={60}
																		height={60}
																		class="size-full object-contain"
																	/>
																</div>
																<div class="size-5 rounded-full bg-neutral-100 group-hover/brand:bg-primary_onyx group-hover/brand:text-white flex items-center justify-center transition-colors">
																	<ArrowUpRight class="size-3 stroke-[2]" />
																</div>
															</div>

															<div class="flex flex-col">
																<span class="font-semibold text-xs sm:text-sm tracking-tight text-primary_onyx group-hover/brand:text-secondary_olive transition-colors">
																	{brand.name}
																</span>
																<span class="text-[10px] sm:text-[11px] text-neutral-500 font-light line-clamp-1">
																	{brand.tagline}
																</span>
															</div>
														</a>
													))
												}
											</div>
										</div>
									</div>

									<!-- Right Column (lg:col-span-5): Curated Visual Showcase -->
									<div class="lg:col-span-5 flex items-center justify-center">
										<div class="relative w-full max-h-[180px] sm:max-h-[220px] lg:max-h-[600px] aspect-[16/10] rounded-2xl overflow-hidden shadow-md group/img bg-neutral-100 border border-black/5 ">
											<Image
												src={category.showcaseImage}
												alt={category.showcaseAlt}
												width={900}
												height={675}
												format="webp"
												quality={90}
												densities={[1, 2]}
												class="w-full h-full object-cover object-center group-hover/img:scale-105 transition-transform duration-700 ease-[cubic-bezier(0.23,1,0.32,1)]"
											/>
										</div>
									</div>
								</div>
							</div>
						</section>
					</div>
				))
			}
		</div>
	</main>
</Layout>

<style>
	.card-header-bar {
		height: 52px;
		min-height: 52px;
		max-height: 52px;
	}

	@media (max-width: 768px) {
		.card-header-bar {
			height: 46px;
			min-height: 46px;
			max-height: 46px;
		}
	}
</style>

<script>
	import gsap from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	function initImageTrail() {
		const hero = document.getElementById("hero-brands");
		const trailContainer = document.getElementById("image-trail-container");
		if (!hero || !trailContainer) return;

		// Check reduced motion or non-hover devices
		if (window.matchMedia("(prefers-reduced-motion: reduce)").matches || !window.matchMedia("(hover: hover)").matches) {
			return;
		}

		const trailItems = gsap.utils.toArray<HTMLElement>(".trail-item");
		if (!trailItems.length) return;

		let currentIdx = 0;
		let lastPos = { x: 0, y: 0 };
		const threshold = 80; // Distance in pixels traveled before spawning next image
		let isInside = false;

		const handleMouseEnter = (e: MouseEvent) => {
			isInside = true;
			const rect = hero.getBoundingClientRect();
			lastPos = { x: e.clientX - rect.left, y: e.clientY - rect.top };
		};

		const handleMouseLeave = () => {
			isInside = false;
		};

		const handleMouseMove = (e: MouseEvent) => {
			if (!isInside) return;
			const rect = hero.getBoundingClientRect();
			const x = e.clientX - rect.left;
			const y = e.clientY - rect.top;

			const distance = Math.hypot(x - lastPos.x, y - lastPos.y);
			if (distance > threshold) {
				lastPos = { x, y };
				spawnTrailImage(x, y);
			}
		};

		function spawnTrailImage(x: number, y: number) {
			const item = trailItems[currentIdx];
			currentIdx = (currentIdx + 1) % trailItems.length;

			// Re-append to bring item to front
			trailContainer?.appendChild(item);

			const randomRot = gsap.utils.random(-8, 8);
			const randomScale = gsap.utils.random(0.95, 1.05);

			gsap.killTweensOf(item);

			gsap.set(item, {
				x: x,
				y: y,
				rotation: randomRot,
				scale: 0.9,
				opacity: 0,
			});

			const tl = gsap.timeline();
			tl.to(item, {
				opacity: 1,
				scale: randomScale,
				duration: 0.2,
				ease: "power2.out",
			}).to(item, {
				opacity: 0,
				scale: 0.85,
				y: y - 20,
				duration: 0.65,
				ease: "power2.in",
				delay: 0.15,
			});
		}

		hero.addEventListener("mouseenter", handleMouseEnter);
		hero.addEventListener("mouseleave", handleMouseLeave);
		hero.addEventListener("mousemove", handleMouseMove);
	}

	function initGSAPPinningStack() {
		gsap.registerPlugin(ScrollTrigger);

		// Clean up existing triggers
		ScrollTrigger.getAll().forEach((t) => {
			if (t.vars.id?.startsWith("card-pin-")) {
				t.kill();
			}
		});

		const cards = gsap.utils.toArray<HTMLElement>(".stacked-card");
		if (!cards.length) return;

		const mm = gsap.matchMedia();

		mm.add("(min-width: 769px)", () => {
			const navHeight = 76;
			const headerHeight = 52;

			cards.forEach((card, idx) => {
				const targetTop = navHeight + idx * headerHeight;

				ScrollTrigger.create({
					id: `card-pin-${idx}`,
					trigger: card,
					start: () => `top top+=${targetTop}`,
					endTrigger: "#stacked-cards-container",
					end: "bottom bottom",
					pin: true,
					pinSpacing: false,
					anticipatePin: 1,
					invalidateOnRefresh: true,
				});
			});
		});

		mm.add("(max-width: 768px)", () => {
			const navHeight = 60;
			const headerHeight = 46;

			cards.forEach((card, idx) => {
				const targetTop = navHeight + idx * headerHeight;

				ScrollTrigger.create({
					id: `card-pin-mobile-${idx}`,
					trigger: card,
					start: () => `top top+=${targetTop}`,
					endTrigger: "#stacked-cards-container",
					end: "bottom bottom",
					pin: true,
					pinSpacing: false,
					anticipatePin: 1,
					invalidateOnRefresh: true,
				});
			});
		});

		ScrollTrigger.refresh();
	}

	function initBrandsHeroEntrance() {
		const hero = document.getElementById("hero-brands");
		if (!hero) return;

		const title = hero.querySelector(".brands-hero-title");
		const desc = hero.querySelector(".brands-hero-desc");

		const elements = [title, desc].filter(Boolean) as HTMLElement[];
		if (!elements.length) return;

		gsap.killTweensOf(elements);

		const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		if (prefersReducedMotion) {
			hero.classList.add("brands-hero-revealed");
			elements.forEach((el) => {
				el.style.filter = "none";
				el.style.transform = "none";
				el.style.opacity = "1";
			});
			return;
		}

		// Calculate precise start delay: wait for page transition curtain if active, else clean settling delay
		const svgTransition = document.getElementById("page-transition-svg");
		const isPageTransitionActive = svgTransition && svgTransition.style.display !== "none";
		const startDelay = isPageTransitionActive ? 0.45 : 0.12;

		const tl = gsap.timeline({
			delay: startDelay,
			onComplete: () => {
				hero.classList.add("brands-hero-revealed");
				elements.forEach((el) => {
					el.style.filter = "none";
					el.style.transform = "none";
				});
			},
		});

		if (title) {
			tl.fromTo(
				title,
				{ opacity: 0, y: 35, filter: "blur(12px)", force3D: true },
				{
					opacity: 1,
					y: 0,
					filter: "blur(0px)",
					duration: 1.15,
					ease: "power3.out",
					force3D: true,
					clearProps: "transform,filter",
				}
			);
		}

		if (desc) {
			tl.fromTo(
				desc,
				{ opacity: 0, y: 25, filter: "blur(10px)", force3D: true },
				{
					opacity: 1,
					y: 0,
					filter: "blur(0px)",
					duration: 1.05,
					ease: "power3.out",
					force3D: true,
					clearProps: "transform,filter",
				},
				"-=0.75"
			);
		}
	}

	function initAll() {
		initImageTrail();
		initGSAPPinningStack();
		initBrandsHeroEntrance();
	}

	document.addEventListener("astro:page-load", initAll);
</script>
